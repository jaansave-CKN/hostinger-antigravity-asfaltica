# Copiar a .env y llenar con valores reales antes de desplegar.
# NUNCA commitear el archivo .env real — solo este .env.example con valores vacíos.

PORT=5180

# Secreto de firma de sesión. Generar uno real con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Conexión a PostgreSQL (Render u otro proveedor).
DATABASE_URL=

# Sprint 0 — auth real por usuario, reemplaza el portón de contraseña única
# (gate.html/SITE_PASSWORD quedaron retirados). Crea el primer usuario con:
#   node scripts/crear-usuario.js --nombre "..." --cedula ... --tenant TEN-XXXX --rol admin-tenant --password "..."
